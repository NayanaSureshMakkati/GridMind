# ---------------------------------------------------------------------------
# Secrets & credentials — NEVER commit these.
# If a real secret file is added later, it is ignored automatically.
# ---------------------------------------------------------------------------
# Environment files (keep a committed sample if you need one: !.env.example)
.env
.env.*
!.env.example
*.env
.envrc

# Private keys / certificates / keystores
*.key
*.pem
*.p12
*.pfx
*.jks
*.keystore
*.ppk

# SSH keys
id_rsa
id_dsa
id_ecdsa
id_ed25519
id_rsa.pub
id_ed25519.pub

# Cloud / service account credentials
credentials.json
credentials*.json
service-account*.json
service_account*.json
client_secret*.json
gcloud-*.json
*.credentials
secrets/
secrets.*

# Tokens & auth stores
*.token
token.txt
tokens.json
.vault-token
.npmrc
.pypirc
.netrc

# ---------------------------------------------------------------------------
